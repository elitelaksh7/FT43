# Environment variables for WalletWise AI Backend
# Copy this file to .env and add your actual API keys

# Google AI (Gemini) API Key - REQUIRED for enhanced AI categorization
# Get your API key from: https://makersuite.google.com/app/apikey
# Without this key, the system will use smart fallback categorization
GOOGLE_AI_API_KEY=AIzaSyA8PudbGjNwrGdelEio-DXxBe_DgdliTEY

# Other optional configurations
DEBUG=true
LOG_LEVEL=info

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Get Gemini API key from Google AI Studio
# 3. Replace 'your_google_ai_api_key_here' with your actual key
# 4. Restart the server to apply changes