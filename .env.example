# FinTrackAI Enhanced Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server settings
NODE_ENV=development
PORT=5000
HOST=localhost

# =============================================================================
# AI INTEGRATION (OpenAI)
# =============================================================================

# OpenAI API Configuration - Required for AI features
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Configuration
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.1

# =============================================================================
# REDIS CONFIGURATION (for Job Queues)
# =============================================================================

# Redis connection for BullMQ job queues
# Install Redis locally or use a cloud service like Upstash, Redis Cloud
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================

# Upload settings
MAX_FILE_SIZE=10485760
# Maximum file size in bytes (10MB = 10 * 1024 * 1024)

UPLOAD_DIR=uploads
# Directory for storing uploaded receipts (relative to server root)

# Allowed file types
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png,image/webp,application/pdf

# =============================================================================
# OCR CONFIGURATION
# =============================================================================

# OCR Processing settings
OCR_CONFIDENCE_THRESHOLD=0.7
# Minimum confidence score for OCR text extraction (0.0-1.0)

OCR_MAX_RETRIES=3
# Maximum retry attempts for failed OCR processing

# =============================================================================
# AI CATEGORIZATION
# =============================================================================

# AI Categorization settings
AI_CONFIDENCE_THRESHOLD=0.8
# Minimum confidence for AI categorization (0.0-1.0)

ENABLE_PII_REDACTION=true
# Enable automatic PII (Personal Identifiable Information) redaction

# =============================================================================
# PRICE COMPARISON
# =============================================================================

# Price comparison settings
PRICE_COMPARISON_ENABLED=true
PRICE_STALENESS_HOURS=24
# How old price data can be before refreshing (in hours)

# =============================================================================
# SMS INTEGRATION
# =============================================================================

# SMS Transaction parsing
SMS_PARSING_ENABLED=true
SMS_CONFIDENCE_THRESHOLD=0.75

# =============================================================================
# BUDGET & NOTIFICATIONS
# =============================================================================

# Budget alert thresholds
BUDGET_WARNING_THRESHOLD=0.8
# Warn when spending reaches 80% of budget

BUDGET_ALERT_THRESHOLD=0.95
# Alert when spending reaches 95% of budget

# =============================================================================
# ANOMALY DETECTION
# =============================================================================

# Anomaly detection settings
ANOMALY_DETECTION_ENABLED=true
ANOMALY_THRESHOLD=2.0
# Standard deviation threshold for anomaly detection

# =============================================================================
# SYSTEM MONITORING
# =============================================================================

# Health check and monitoring
HEALTH_CHECK_ENABLED=true
METRICS_RETENTION_DAYS=30
# How long to keep system metrics

# =============================================================================
# SECURITY
# =============================================================================

# Security settings
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_DETAILS=true
# Set to false in production to avoid leaking sensitive error information

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
# 100 requests per 15 minutes (900,000 ms)

# =============================================================================
# DATABASE (if using external database instead of in-memory)
# =============================================================================

# Uncomment and configure if using PostgreSQL instead of in-memory storage
# DATABASE_URL=postgresql://username:password@localhost:5432/fintrack
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=fintrack
# DB_USER=username
# DB_PASSWORD=password
# DB_SSL=false

# =============================================================================
# DEVELOPMENT/DEBUG
# =============================================================================

# Development settings
DEBUG_MODE=true
VERBOSE_LOGGING=true
LOG_LEVEL=info

# Mock services (for development without external dependencies)
MOCK_AI_RESPONSES=false
# Set to true to use mock AI responses instead of actual OpenAI calls

MOCK_PRICE_COMPARISON=false
# Set to true to use mock price data instead of real price comparison

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable specific features
FEATURE_OCR_PROCESSING=true
FEATURE_AI_CATEGORIZATION=true
FEATURE_PRICE_COMPARISON=true
FEATURE_SMS_PARSING=true
FEATURE_ANOMALY_DETECTION=true
FEATURE_BUDGET_ALERTS=true
FEATURE_INTELLIGENT_NUDGES=true
FEATURE_REAL_TIME_UPDATES=true

# =============================================================================
# EXAMPLE VALUES FOR QUICK SETUP
# =============================================================================

# Uncomment these for quick local development setup:
# NODE_ENV=development
# PORT=5000
# OPENAI_API_KEY=sk-your-key-here
# REDIS_URL=redis://localhost:6379
# DEBUG_MODE=true
# MOCK_AI_RESPONSES=true
# MOCK_PRICE_COMPARISON=true