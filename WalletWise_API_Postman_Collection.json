            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"INR 1200 debited from your account. Paid to Swiggy Instamart on 2024-01-16\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/parse-text/",
              "host": ["{{baseUrl}}"],
              "path": ["parse-text", ""]
            },
            "description": "Parse a Swiggy Instamart transaction"
