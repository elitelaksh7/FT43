        },
        {
          "name": "Parse SMS - H&M",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Transaction successful! Rs.2500 paid to H&M via UPI Ref: 123456789\"\n}"
