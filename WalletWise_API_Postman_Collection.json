      "item": [
        {
          "name": "Parse SMS - Zomato",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"You spent Rs.500 at Zomato on 2024-01-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/parse-text/",
              "host": ["{{baseUrl}}"],
              "path": ["parse-text", ""]
            },
            "description": "Parse a Zomato transaction from SMS text"
          }
        },
        {
          "name": "Parse SMS - Swiggy",
          "request": {
            "method": "POST",
            "header": [
