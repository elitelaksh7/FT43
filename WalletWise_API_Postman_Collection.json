            "description": "Parse an H&M clothing store transaction"
          }
        },
        {
          "name": "Parse Image (OCR)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/receipt/image.jpg",
                  "description": "Upload a receipt or bill image"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/parse-image/",
              "host": ["{{baseUrl}}"],
              "path": ["parse-image", ""]
            },
            "description": "Extract transaction details from receipt/bill image using OCR"
          }
        }
      ],
      "description": "Endpoints for parsing transactions from text and images"
